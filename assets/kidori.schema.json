{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "kidori project",
  "description": "kidori ファイル（*.kidori.yaml / *.kidori.json 等）のスキーマ。拡張はファイルごとにメモリ上で合成して供給し、kidori init は動的 enum なしの基底スキーマを kidori.schema.json として書き出す（SPECS.md §3a・§4b）。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "meta",
    "stocks",
    "parts"
  ],
  "properties": {
    "stocksFile": {
      "type": "string",
      "minLength": 1,
      "description": "外部 stocks ファイル（例: 同居プロジェクト間で共有する ./stocks.yaml）への参照。相対パス限定とし、参照先は正本セットの一部（一緒にコミットする前提）。参照先はトップレベル stocks: リストを持つ1段のみのファイルで、インラインの stocks と id が衝突した場合はインラインが勝つ。"
    },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project",
        "units",
        "schemaVersion"
      ],
      "properties": {
        "project": {
          "type": "string",
          "description": "プロジェクト名（例: \"書棚\"）。"
        },
        "units": {
          "type": "string",
          "description": "単位。mm 固定（他の値は loader の意味検証で error になる）。"
        },
        "schemaVersion": {
          "type": "string",
          "description": "正本のスキーマバージョン表記。想定バージョンと不一致の場合はloader が warning を出す。"
        }
      }
    },
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kerf": {
          "type": "number",
          "minimum": 0,
          "default": 3,
          "description": "鋸刃厚（mm）。割付時に切断ごとに消費される。デフォルト 3。"
        },
        "edgeTrim": {
          "type": "number",
          "minimum": 0,
          "default": 5,
          "description": "原材の端の捨て代（mm）。荒れた木口を落とす分。デフォルト 5。"
        },
        "candidates": {
          "type": "integer",
          "default": 3,
          "description": "生成する割付候補数（デフォルト 3）。1〜3 にクランプされる（4 以上の指定は loader が warning を出す）。"
        },
        "rank": {
          "type": "array",
          "items": {
            "enum": [
              "cost",
              "waste",
              "cuts"
            ]
          },
          "uniqueItems": true,
          "default": [
            "cost",
            "waste",
            "cuts"
          ],
          "description": "推奨案の評価優先順。\"cost\"（概算費用）・\"waste\"（歩留まり）・\"cuts\"（カット回数）を優先順に並べる。デフォルト [\"cost\", \"waste\", \"cuts\"]。重複・空配列は error になる。"
        },
        "exact": {
          "enum": [
            "auto",
            "on",
            "off"
          ],
          "default": "auto",
          "description": "厳密探索モード。auto（既定）は部材数が小さいとき（目安 15 以下）のみ全探索（分枝限定）を実行し、真に最適な構成を候補 X として加える。on は常に実行、off は実行しない。"
        },
        "selectedPlan": {
          "default": null,
          "description": "採用した案の ID（\"A\"/\"B\"/\"C\"/\"X\"。X は厳密探索案）。null の間は全案を出力する。",
          "anyOf": [
            {
              "type": "null"
            },
            {
              "enum": [
                "A",
                "B",
                "C",
                "X"
              ]
            }
          ]
        }
      }
    },
    "stocks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "kind",
          "length",
          "width",
          "thickness"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
            "description": "原材 ID。parts[].stock から参照される。出力ファイル名に使用するため、英数字で始まり英数字・「.」「_」「-」のみ使用できる。"
          },
          "preset": {
            "type": "string",
            "minLength": 1,
            "description": "規格材マスタ側のキー（来歴メタデータ。任意）。補完確定時に自動挿入される。ビルドは preset を一切解決せず、実値フィールドは preset があっても全て必須のまま（正本の自己完結性を維持）。マスタへの追従をやめたいときはキーを消すだけでよい。"
          },
          "label": {
            "type": "string",
            "description": "表示ラベル（例: \"1×4材 6F\"）。"
          },
          "kind": {
            "enum": [
              "bar",
              "sheet"
            ],
            "description": "bar（1D割付・長さのみ使用）または sheet（2D割付・長さ×幅を使用）。"
          },
          "length": {
            "type": "number",
            "exclusiveMinimum": 0,
            "description": "原材の長さ（mm）。"
          },
          "width": {
            "type": "number",
            "exclusiveMinimum": 0,
            "description": "原材の幅（mm）。bar の場合は部材の実効幅として使われる。"
          },
          "thickness": {
            "type": "number",
            "exclusiveMinimum": 0,
            "description": "原材の厚み（mm）。"
          },
          "price": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "description": "単価（円）。省略可。省略時は費用計算で price 欠落として扱われる。"
          }
        }
      }
    },
    "parts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "qty",
          "stock",
          "length"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
            "description": "部材 ID。出力ファイル名（<stem>.out/parts/{id}.svg）に使われるため、英数字で始まり英数字・「.」「_」「-」のみ使用できる。"
          },
          "label": {
            "type": "string",
            "description": "表示ラベル。"
          },
          "qty": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "description": "必要数量。"
          },
          "stock": {
            "type": "string",
            "description": "使用する原材の id 参照。stocks の id が補完候補になる（存在しない id はここでエラーになる）。"
          },
          "length": {
            "type": "number",
            "exclusiveMinimum": 0,
            "description": "部材の長さ（mm）。"
          },
          "width": {
            "type": "number",
            "exclusiveMinimum": 0,
            "description": "部材の幅（mm）。bar 部材では省略可（省略時、または指定時も stock.width と同値のみ許容）。sheet 部材では必須。"
          },
          "rot": {
            "type": "boolean",
            "default": true,
            "description": "2D割付時の90度回転可否。デフォルト true。木目を通したい部材は false。bar 部材では意味を持たない（指定すると loader が warning を出す）。"
          },
          "features": {
            "type": "array",
            "default": [],
            "description": "加工フィーチャ（溝・丸穴）の配列。",
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "type",
                    "face",
                    "dir",
                    "pos",
                    "width",
                    "depth",
                    "end"
                  ],
                  "properties": {
                    "type": {
                      "const": "groove",
                      "description": "フィーチャ種別。groove（溝）または hole（丸穴）。"
                    },
                    "face": {
                      "enum": [
                        "front",
                        "back"
                      ],
                      "description": "加工面。front は実線＋薄塗り、back は破線（隠れ線規約）で描画される。"
                    },
                    "dir": {
                      "enum": [
                        "across",
                        "along"
                      ],
                      "description": "溝の走行方向。across（幅方向）または along（長さ方向）。"
                    },
                    "pos": {
                      "type": "number",
                      "minimum": 0,
                      "description": "基準端から溝中心までの距離（mm）。寸法線抽出でも中心基準として扱う。"
                    },
                    "width": {
                      "type": "number",
                      "exclusiveMinimum": 0,
                      "description": "溝幅（mm）。"
                    },
                    "depth": {
                      "type": "number",
                      "exclusiveMinimum": 0,
                      "description": "溝深さ（mm）。stock.thickness 以下でなければならない（意味検証層）。"
                    },
                    "end": {
                      "enum": [
                        "through",
                        "stopped"
                      ],
                      "description": "through（通し）または stopped（止め、止めの場合 from/to を追加）。"
                    },
                    "from": {
                      "type": "number",
                      "minimum": 0,
                      "description": "end: stopped の場合のみ使用する、走行方向の開始座標（mm）。"
                    },
                    "to": {
                      "type": "number",
                      "minimum": 0,
                      "description": "end: stopped の場合のみ使用する、走行方向の終了座標（mm）。"
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "type",
                    "face",
                    "x",
                    "y",
                    "dia"
                  ],
                  "properties": {
                    "type": {
                      "const": "hole",
                      "description": "フィーチャ種別。groove（溝）または hole（丸穴）。"
                    },
                    "face": {
                      "enum": [
                        "front",
                        "back"
                      ],
                      "description": "加工面。front または back。"
                    },
                    "x": {
                      "type": "number",
                      "minimum": 0,
                      "description": "部材ローカル座標系での中心 X 座標（mm）。"
                    },
                    "y": {
                      "type": "number",
                      "minimum": 0,
                      "description": "部材ローカル座標系での中心 Y 座標（mm）。"
                    },
                    "dia": {
                      "type": "number",
                      "exclusiveMinimum": 0,
                      "description": "径（mm）。"
                    },
                    "depth": {
                      "type": [
                        "number",
                        "null"
                      ],
                      "exclusiveMinimum": 0,
                      "description": "深さ（mm）。省略時は貫通を表す。"
                    }
                  }
                }
              ]
            }
          }
        }
      }
    }
  }
}
