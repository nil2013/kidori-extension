{
  "name": "kidori",
  "displayName": "kidori",
  "description": "規格材の木取り図・加工指示図に特化した VS Code 拡張。正本 *.kidori.yaml から SVG/PNG を自動生成する。",
  "version": "0.6.0",
  "publisher": "tnishimura",
  "license": "MIT",
  "private": true,
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "bin": {
    "kidori": "./dist/cli.js"
  },
  "extensionDependencies": [
    "redhat.vscode-yaml"
  ],
  "activationEvents": [
    "workspaceContains:**/*.kidori.yaml",
    "workspaceContains:**/*.kidori.yml",
    "workspaceContains:**/*.kidori.json",
    "onLanguage:yaml",
    "onLanguage:json"
  ],
  "contributes": {
    "commands": [
      {
        "command": "kidori.new",
        "title": "kidori: New Cutting Plan（木取りファイルの雛形を生成）"
      },
      {
        "command": "kidori.init",
        "title": "kidori: ディレクトリを初期化（AGENTS.md・スキーマ等を生成）"
      },
      {
        "command": "kidori.build",
        "title": "kidori: ビルド（木取り図・加工指示図を再生成）"
      },
      {
        "command": "kidori.openPreview",
        "title": "kidori: プレビューを開く"
      },
      {
        "command": "kidori.selectPlan",
        "title": "kidori: 案を採用する"
      },
      {
        "command": "kidori.insertAssembly",
        "title": "kidori: 構成を挿入（parts＋assembly の雛形）"
      }
    ],
    "jsonValidation": [
      {
        "fileMatch": "*.kidori.json",
        "url": "./assets/kidori.schema.json"
      }
    ],
    "configuration": {
      "title": "kidori",
      "properties": {
        "kidori.buildOnSave": {
          "type": "boolean",
          "default": true,
          "description": "kidori ファイル（*.kidori.yaml など、または meta.schemaVersion を持つ *.yaml / *.json）の保存時に自動でビルドする。"
        },
        "kidori.png.enabled": {
          "type": "boolean",
          "default": true,
          "description": "SVG と同時に PNG も生成する。"
        },
        "kidori.png.scale": {
          "type": "number",
          "default": 2,
          "description": "PNG 変換時のスケール倍率。"
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "package": "npm run build && vsce package --allow-missing-repository"
  },
  "dependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "yaml": "^2.8.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.0.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
